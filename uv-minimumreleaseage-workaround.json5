{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Use workarounds for uv minimumReleaseAge",
  // Disable lockFileMaintenance for pep621 as it doesn't yet respect minimumReleaseAge for uv.
  // Should be fixed by PR: https://github.com/renovatebot/renovate/pull/43681
  "pep621": {
    "lockFileMaintenance": {
      "enabled": false
    }
  },
  // Define rangeStrategy as "widen" for python dependencies instead of the "in-range-only"
  // specified in default.json5. Currently this strategy doesn't work with minimumReleaseAge for uv,
  // and will try (and fail) to increase to a pending version beyond the minimumReleaseAge.
  // This should be fixed by either of these open PRs:
  // https://github.com/renovatebot/renovate/pull/43681
  // https://github.com/renovatebot/renovate/pull/45370
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "widen"
    }
  ]
}

