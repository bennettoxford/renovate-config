// Disable lockFileMaintenance for pep621 as it doesn't yet respect minimumReleaseAge for uv.
// Should be fixed by PR: https://github.com/renovatebot/renovate/pull/43681
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Disable Renovate lockfile maintenance for PEP 621 / uv projects",
  "pep621": {
    "lockFileMaintenance": {
      "enabled": false
    }
  }
}
